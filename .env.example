# OCODEJS Codespaces — local development placeholders only.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=gen-lang-client-0137515073.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=gen-lang-client-0137515073
NEXT_PUBLIC_FIREBASE_APP_ID=
# Do not commit real credentials. The Firebase project ID is public configuration.
FIREBASE_PROJECT_ID=gen-lang-client-0137515073

# Future GitHub App integration (configure only after app ownership,
# permissions, callback URLs, and least-privilege scopes are reviewed).
# OCODEJS_GITHUB_APP_ID=
# OCODEJS_GITHUB_CLIENT_ID=
# OCODEJS_GITHUB_CLIENT_SECRET=
# OCODEJS_GITHUB_PRIVATE_KEY=

# PostgreSQL control-plane storage. Run npm run migrate after DATABASE_URL is set.
DATABASE_URL=
# Set to disable TLS only for local development; leave unset for hosted PostgreSQL.
# PGSSLMODE=disable

# Future isolated runtime provider; remains disabled until security gates pass.
# OCODEJS_WORKSPACE_PROVIDER=disabled
